<%- include('layout_top', {pageTitle: t('canali_title') + ' - ' + t('site_name'), pageDesc: t('canali_lede')}) %>
<section class="hero">
  <h1><%= t('canali_title') %></h1>
  <p><%= t('canali_lede') %></p>
  <p class="stats"><strong><%= totale %></strong> <%= t('canali_tot') %></p>
</section>
<% gruppi.forEach(function(g, i){ %>
<details class="gruppo" <%= i === 0 ? 'open' : '' %>>
  <summary><%= g.nome %> <span class="chip"><%= g.fonti.length %></span></summary>
  <div class="tablewrap"><table class="canali">
    <% g.fonti.forEach(function(c){ %>
    <tr>
      <td><strong><%= c.nome %></strong><% if (c.regione) { %> <span class="muted">· <%= c.regione %></span><% } %>
        <% if (c.feed) { %><span class="chip alt"><%= t('canali_feed') %></span><% } %><% if (!c.verificato) { %><span class="chip warn"><%= t('canali_nv') %></span><% } %></td>
      <td><a href="<%= c.url_bandi %>" target="_blank" rel="noopener nofollow"><%= c.url_bandi.replace(/^https?:\/\/(www\.)?/, '').slice(0, 60) %></a></td>
    </tr>
    <% }) %>
  </table></div>
</details>
<% }) %>
<%- include('layout_bottom') %>
