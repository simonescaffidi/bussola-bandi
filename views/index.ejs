<%- include('layout_top') %>
<section class="hero">
  <h1><%= t('h1') %></h1>
  <p><%= t('lede') %></p>
  <p class="stats"><strong><%= stat.n.toLocaleString('it-IT') %></strong> <%= t('stat_bandi') %> · <strong><%= nFonti %></strong> <a href="/canali"><%= t('stat_fonti') %></a><% if (stat.agg) { %> · <%= t('stat_agg') %>: <%= new Date(stat.agg).toLocaleDateString(lang === 'en' ? 'en-GB' : 'it-IT', { timeZone: 'Europe/Rome' }) %><% } %></p>
  <% if (lang === 'en') { %><p class="stats"><%= t('en_note') %></p><% } %>
</section>

<form class="filters" method="get" action="/">
  <div class="field">
    <label for="q"><%= t('f_search') %></label>
    <input type="text" name="q" id="q" value="<%= f.q %>" placeholder="<%= t('f_search_ph') %>">
  </div>
  <div class="field">
    <label for="target"><%= t('f_target') %></label>
    <select name="target" id="target">
      <option value=""><%= t('all') %></option>
      <option value="cittadino" <%= f.target==='cittadino'?'selected':'' %>><%= t('citizen') %></option>
      <option value="impresa" <%= f.target==='impresa'?'selected':'' %>><%= t('business') %></option>
    </select>
  </div>
  <div class="field">
    <label for="regione"><%= t('f_region') %></label>
    <select name="regione" id="regione">
      <option value=""><%= t('all') %></option>
      <% regioni.forEach(function(r){ %><option value="<%= r %>" <%= f.regione===r?'selected':'' %>><%= r %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="settore"><%= t('f_sector') %></label>
    <select name="settore" id="settore">
      <option value=""><%= t('all') %></option>
      <% settori.forEach(function(s){ %><option value="<%= s.settore %>" <%= f.settore===s.settore?'selected':'' %>><%= t('settore_' + s.settore) %> (<%= s.n %>)</option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="livello"><%= t('f_level') %></label>
    <select name="livello" id="livello">
      <option value=""><%= t('all') %></option>
      <% ['europeo','nazionale','regionale'].forEach(function(l){ %><option value="<%= l %>" <%= f.livello===l?'selected':'' %>><%= t('lvl_' + l) %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="stato"><%= t('f_stato') %></label>
    <select name="stato" id="stato">
      <option value=""><%= t('all') %></option>
      <% stati.forEach(function(st){ %><option value="<%= st %>" <%= f.stato===st?'selected':'' %>><%= t('stato_' + st) %></option><% }) %>
    </select>
  </div>
  <% if (province.length) { %>
  <div class="field">
    <label for="provincia"><%= t('f_province') %></label>
    <select name="provincia" id="provincia">
      <option value=""><%= t('all') %></option>
      <% province.forEach(function(pr){ %><option value="<%= pr %>" <%= f.provincia===pr?'selected':'' %>><%= pr %></option><% }) %>
    </select>
  </div>
  <% } %>
  <div class="field field-wide">
    <label class="check"><input type="hidden" name="naz" value="0"><input type="checkbox" name="naz" value="1" <%= f.naz==='1'?'checked':'' %>> <%= t('f_naz') %></label>
  </div>
  <div class="field actions">
    <button type="submit" class="btn"><%= t('search_btn') %></button>
    <a href="/" class="reset"><%= t('reset') %></a>
  </div>
</form>

<div class="count"><strong><%= tot.toLocaleString('it-IT') %></strong> <%= t('results') %></div>
<div class="results">
  <% bandi.forEach(function(b){ var scad = b.data_chiusura ? new Date(b.data_chiusura).toLocaleDateString(lang === 'en' ? 'en-GB' : 'it-IT') : (b.scadenza === 'rolling' || b.scadenza === 'a sportello' ? t('rolling') : (b.scadenza || '-')); %>
  <article class="card">
    <div><span class="chip st-<%= b.stato %>"><%= t('stato_' + b.stato) %></span><span class="chip"><%= t('lvl_' + b.livello) %></span><span class="chip"><%= b.regione %></span><span class="chip alt"><%= t('settore_' + b.settore) %></span></div>
    <h3><a href="/bando/<%= encodeURIComponent(b.id) %>"><%= lang==='en' ? b.title_en : b.title_it %></a></h3>
    <div class="ente"><%= b.ente %></div>
    <p><%= lang==='en' ? b.sintesi_en : b.sintesi_it %></p>
    <div class="meta">
      <span><strong><%= t('deadline') %>:</strong> <%= scad %></span>
      <span><strong><%= t('amount') %>:</strong> <%= lang==='en' ? b.importo_en : b.importo_it %></span>
      <% if (b.beneficiari) { %><span><strong><%= t('beneficiaries') %>:</strong> <%= b.beneficiari.length > 140 ? b.beneficiari.slice(0,137) + '…' : b.beneficiari %></span><% } %>
      <% if (b.fonte) { %><span><strong><%= t('source') %>:</strong> <%= b.fonte %></span><% } %>
    </div>
    <a class="btn" href="/bando/<%= encodeURIComponent(b.id) %>"><%= t('details') %></a>
    <% if (b.simulatore) { %><a class="btn ghost" href="/simulatori/<%= b.simulatore %>"><%= t('nav_simulatori') %></a><% } %>
    <a class="btn ghost" href="<%= b.link %>" target="_blank" rel="noopener"><%= t('go_to') %> ↗</a>
  </article>
  <% }) %>
</div>
<% if (!bandi.length) { %><p class="count"><%= t('no_results') %></p><% } %>
<% if (pagine > 1) { %>
<nav class="pager">
  <% if (pagina > 1) { %><a href="/?<%= qs %><%= qs ? '&' : '' %>p=<%= pagina - 1 %>">← <%= t('prev') %></a><% } %>
  <span><%= t('page') %> <%= pagina %> <%= t('of') %> <%= pagine %></span>
  <% if (pagina < pagine) { %><a href="/?<%= qs %><%= qs ? '&' : '' %>p=<%= pagina + 1 %>"><%= t('next') %> →</a><% } %>
</nav>
<% } %>
<%- include('layout_bottom') %>
